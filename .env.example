# All settings are optional; defaults are in src/config.ts.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only when running behind a proxy/CDN you control (needed for per-client rate limits).
TRUST_PROXY=false
MAX_SOURCE_BYTES=15728640
MAX_INPUT_PIXELS=40000000
MAX_OUTPUT_DIMENSION=4000
FETCH_TIMEOUT_MS=8000
MAX_REDIRECTS=3
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CACHE_MAX_BYTES=104857600
CACHE_TTL_SECONDS=86400
